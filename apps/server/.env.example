# The sync server's environment. Copy to .env for local runs; in
# production set these on the host. Every value here is an example.

NODE_ENV=development
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Required in production.
MONGO_URL=mongodb://127.0.0.1:27017/harvest

# Ed25519, PEM (PKCS#8 private, SPKI public). Required in production;
# outside it a fresh pair is made at every start, which signs everyone
# out on restart. Generate a pair with:
#   openssl genpkey -algorithm ed25519 -out jwt.key
#   openssl pkey -in jwt.key -pubout -out jwt.pub
# Newlines may be written as \n on one line.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# The web app's origins, comma-separated. Requests with no Origin (the
# phone) are always allowed.
CORS_ORIGINS=http://localhost:5173
# The refresh cookie's Secure flag. Defaults to true everywhere but
# development, where the web runs on plain http.
COOKIE_SECURE=false
# Reverse-proxy hops in front of the server (1 behind one proxy), so
# rate limits see the client's real address.
TRUST_PROXY=0
BODY_LIMIT=5mb

# Where the emailed links point: the web app.
APP_URL=http://localhost:5173

# Required in production; without it mail goes to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Harvest <no-reply@example.com>

# The key the server lends to signed-in accounts for the writing
# assist. Without it the server simply offers none, and the clients say
# so. Requests per account per UTC day, and the model's name:
ASSIST_API_KEY=
ASSIST_MODEL=gemini-2.5-flash
ASSIST_DAILY_LIMIT=50

# The repository whose latest release the download page offers.
GITHUB_REPO=ABakdi/Harvest
# Optional: raises GitHub's rate limit for the release proxy.
GITHUB_TOKEN=
