  "fixed_sql": [
    {
      "name": "commitments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"commitments\" (\"uuid\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"schedule_json\" TEXT NULL, \"total_target\" INTEGER NULL, \"daily_commitment\" INTEGER NULL, \"due_day\" TEXT NULL, \"paused_at\" INTEGER NULL, \"note\" TEXT NULL, \"remind_at\" TEXT NULL, \"deadline\" TEXT NULL, \"archived_at\" INTEGER NULL, \"deleted_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"uuid\"));"
        }
      ]
    },
    {
      "name": "check_ins",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"check_ins\" (\"uuid\" TEXT NOT NULL, \"commitment_uuid\" TEXT NOT NULL REFERENCES commitments (uuid), \"harvest_day\" TEXT NOT NULL, \"quantity\" INTEGER NOT NULL DEFAULT 1, \"logged_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"deleted_at\" INTEGER NULL, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"uuid\"));"
        }
      ]
    },
    {
      "name": "streaks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"streaks\" (\"scope\" TEXT NOT NULL, \"current\" INTEGER NOT NULL DEFAULT 0, \"best\" INTEGER NOT NULL DEFAULT 0, \"last_earned_day\" TEXT NULL, \"freezes_stored\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"scope\"));"
        }
      ]
    },
    {
      "name": "ledger",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ledger\" (\"uuid\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"delta\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL, \"harvest_day\" TEXT NOT NULL, \"logged_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"uuid\"));"
        }
      ]
    },
    {
      "name": "quests",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quests\" (\"uuid\" TEXT NOT NULL, \"harvest_day\" TEXT NOT NULL, \"template_id\" TEXT NOT NULL, \"progress\" INTEGER NOT NULL DEFAULT 0, \"target\" INTEGER NOT NULL, \"claimed_at\" INTEGER NULL, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"uuid\"));"
        }
      ]
    },
    {
      "name": "pomodoro_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pomodoro_sessions\" (\"uuid\" TEXT NOT NULL, \"commitment_uuid\" TEXT NULL, \"focus_blocks\" INTEGER NOT NULL DEFAULT 0, \"harvest_day\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NULL, PRIMARY KEY (\"uuid\"));"
        }
      ]
    },
    {
      "name": "expenses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expenses\" (\"uuid\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL DEFAULT 'DZD', \"category\" TEXT NOT NULL, \"note\" TEXT NULL, \"harvest_day\" TEXT NOT NULL, \"logged_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"deleted_at\" INTEGER NULL, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"uuid\"));"
        }
