# The public name the site answers on; Caddy or deploy.sh fetches its
# certificate.
HARVEST_DOMAIN=harvest.example.org
# deploy.sh only: Let's Encrypt's contact, www.HARVEST_DOMAIN too (1 or
# empty), and the loopback port the server listens on. deploy.sh keeps
# these up to date from its flags.
HARVEST_ACME_EMAIL=
HARVEST_WWW=
HARVEST_API_PORT=8080
# MongoDB's version: 7, or 4.4 on a CPU without AVX (deploy.sh decides
# on its first run and keeps it; never move it down).
HARVEST_MONGO_VERSION=

# MongoDB's users: root (for me and deploy.sh) and the one the server
# connects as, which may only read and write the harvest database.
# deploy.sh makes both passwords; by hand: openssl rand -hex 24
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# 32 bytes, base64, sealing every account's key share. deploy.sh makes
# it; by hand: openssl rand -base64 32. Losing it makes every private
# tier on this server unreadable: back up this file with the volume.
KEY_SHARE_KEY=

# Ed25519 pair, PEM, newlines written as \n on one line:
#   openssl genpkey -algorithm ed25519 -out jwt.key
#   openssl pkey -in jwt.key -pubout -out jwt.pub
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Mail for verification and password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Only for a relay on this machine: send without STARTTLS.
SMTP_ALLOW_PLAINTEXT=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Harvest <no-reply@example.org>

# Optional: the writing assist the server lends to accounts.
ASSIST_API_KEY=
ASSIST_MODEL=gemini-2.5-flash
ASSIST_DAILY_LIMIT=50
ASSIST_GLOBAL_DAILY_LIMIT=1000

GITHUB_REPO=ABakdi/Harvest
GITHUB_TOKEN=
