{
  "about": "The sync secret's rule (Accounts AC7). Accepted: a PIN of 4 to 6 ASCII digits [0-9], or a passphrase of 8 characters or more. A secret made only of ASCII digits is a PIN, so any other digit count is pinTooShort / pinTooLong. Anything else under 8 characters is passphraseTooShort; the empty string is empty. Characters are Unicode code points (Dart: runes.length), nothing is trimmed, and other scripts' digits are not PIN digits. expected is null when the secret is accepted.",
  "cases": [
    {
      "input": "",
      "expected": "empty"
    },
    {
      "input": "1",
      "expected": "pinTooShort"
    },
    {
      "input": "123",
      "expected": "pinTooShort"
    },
    {
      "input": "1234",
      "expected": null
    },
    {
      "input": "0000",
      "expected": null
    },
    {
      "input": "12345",
      "expected": null
    },
    {
      "input": "123456",
      "expected": null
    },
    {
      "input": "1234567",
      "expected": "pinTooLong"
    },
    {
      "input": "12345678",
      "expected": "pinTooLong"
    },
    {
      "input": "123456789012",
      "expected": "pinTooLong"
    },
    {
      "input": "abc",
      "expected": "passphraseTooShort"
    },
    {
      "input": "12a4",
      "expected": "passphraseTooShort"
    },
    {
      "input": "1234567a",
      "expected": null
    },
    {
      "input": "1234 ",
      "expected": "passphraseTooShort"
    },
    {
      "input": " 1234",
      "expected": "passphraseTooShort"
    },
    {
      "input": "1 234",
      "expected": "passphraseTooShort"
    },
    {
      "input": "        ",
      "expected": null
    },
    {
      "input": "pass wd",
      "expected": "passphraseTooShort"
    },
    {
      "input": "password",
      "expected": null
    },
    {
      "input": "correct horse battery staple",
      "expected": null
    },
    {
      "input": "١٢٣٤",
      "expected": "passphraseTooShort"
    },
    {
      "input": "١٢٣٤٥٦٧٨",
      "expected": null
    },
    {
      "input": "كلمةسرّ",
      "expected": "passphraseTooShort"
    },
    {
      "input": "كلمة سرّي",
      "expected": null
    },
    {
      "input": "🌱🌱🌱🌱🌱🌱🌱",
      "expected": "passphraseTooShort"
    },
    {
      "input": "🌱🌱🌱🌱🌱🌱🌱🌱",
      "expected": null
    },
    {
      "input": "-1234",
      "expected": "passphraseTooShort"
    },
    {
      "input": "+1234567",
      "expected": null
    }
  ]
}
