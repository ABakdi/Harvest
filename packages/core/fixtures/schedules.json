{
  "about": "Schedule.isDueOn on its own: the schedule's rhythm, before the start day, pausing or the seed type are applied. Schedules are the JSON the phone stores in commitments.schedule_json. 2026-09-14 is a Monday.",
  "cases": [
    { "schedule": { "type": "daily" }, "day": "2026-09-19", "due": true },
    { "schedule": { "type": "daily" }, "day": "1999-01-01", "due": true, "why": "a schedule has no start day of its own" },

    { "schedule": { "type": "weekly", "weekdays": [1, 3, 5] }, "day": "2026-09-14", "due": true },
    { "schedule": { "type": "weekly", "weekdays": [1, 3, 5] }, "day": "2026-09-15", "due": false },
    { "schedule": { "type": "weekly", "weekdays": [1, 3, 5] }, "day": "2026-09-16", "due": true },
    { "schedule": { "type": "weekly", "weekdays": [1, 3, 5] }, "day": "2026-09-18", "due": true },
    { "schedule": { "type": "weekly", "weekdays": [1, 3, 5] }, "day": "2026-09-19", "due": false },
    { "schedule": { "type": "weekly", "weekdays": [7] }, "day": "2026-09-20", "due": true, "why": "Sunday is 7, not 0" },
    { "schedule": { "type": "weekly", "weekdays": [7] }, "day": "2026-09-14", "due": false },

    { "schedule": { "type": "interval", "everyDays": 3, "anchorDay": "2026-09-10" }, "day": "2026-09-10", "due": true },
    { "schedule": { "type": "interval", "everyDays": 3, "anchorDay": "2026-09-10" }, "day": "2026-09-11", "due": false },
    { "schedule": { "type": "interval", "everyDays": 3, "anchorDay": "2026-09-10" }, "day": "2026-09-13", "due": true },
    { "schedule": { "type": "interval", "everyDays": 3, "anchorDay": "2026-09-10" }, "day": "2026-09-07", "due": false, "why": "nothing before the anchor" },
    { "schedule": { "type": "interval", "everyDays": 2, "anchorDay": "2026-03-27" }, "day": "2026-03-29", "due": true, "why": "counted in calendar days across a DST night" },
    { "schedule": { "type": "interval", "everyDays": 2, "anchorDay": "2026-03-27" }, "day": "2026-03-30", "due": false },
    { "schedule": { "type": "interval", "everyDays": 7, "anchorDay": "2026-01-01" }, "day": "2026-12-31", "due": true },
    { "schedule": { "type": "interval", "everyDays": 1, "anchorDay": "2026-09-19" }, "day": "2026-09-19", "due": true },

    { "schedule": { "type": "timesPerWeek", "times": 3 }, "day": "2026-09-19", "doneDaysThisWeek": 0, "due": true },
    { "schedule": { "type": "timesPerWeek", "times": 3 }, "day": "2026-09-19", "doneDaysThisWeek": 2, "due": true },
    { "schedule": { "type": "timesPerWeek", "times": 3 }, "day": "2026-09-19", "doneDaysThisWeek": 3, "due": false, "why": "the week's quota is met" },
    { "schedule": { "type": "timesPerWeek", "times": 3 }, "day": "2026-09-19", "doneDaysThisWeek": 4, "due": false }
  ]
}
