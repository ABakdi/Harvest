{
  "about": "Rates.toDefault (currency.dart) and BudgetSnapshot (expense.dart) with the budgetSnapshot provider's split of a month's day totals (finance_providers.dart). Amounts are minor units.",
  "conversions": [
    {
      "why": "the default currency converts to itself",
      "rates": { "defaultCurrency": "DZD", "dzdPerUsd": 135.0 },
      "minor": 45000,
      "from": "DZD",
      "result": 45000
    },
    {
      "why": "USD into DZD at the hand-typed leg",
      "rates": { "defaultCurrency": "DZD", "dzdPerUsd": 135.0 },
      "minor": 1000,
      "from": "USD",
      "result": 135000
    },
    {
      "why": "DZD into USD is the same leg the other way",
      "rates": { "defaultCurrency": "USD", "dzdPerUsd": 135.0 },
      "minor": 13500,
      "from": "DZD",
      "result": 100
    },
    {
      "why": "EUR into USD uses the fetched rate directly",
      "rates": { "defaultCurrency": "USD", "usdPerEur": 1.1 },
      "minor": 1000,
      "from": "EUR",
      "result": 1100
    },
    {
      "why": "and USD into EUR is its inverse, rounded",
      "rates": { "defaultCurrency": "EUR", "usdPerEur": 1.1 },
      "minor": 1000,
      "from": "USD",
      "result": 909
    },
    {
      "why": "a missing rate converts to nothing at all",
      "rates": { "defaultCurrency": "DZD" },
      "minor": 1000,
      "from": "USD",
      "result": null
    },
    {
      "why": "a rate of zero is not a rate",
      "rates": { "defaultCurrency": "DZD", "dzdPerUsd": 0 },
      "minor": 1000,
      "from": "USD",
      "result": null
    },
    {
      "why": "EUR into DZD via the DZD leg",
      "rates": { "defaultCurrency": "DZD", "dzdPerEur": 150.0 },
      "minor": 2000,
      "from": "EUR",
      "result": 300000
    }
  ],
  "budgets": [
    {
      "why": "a tenth of the way into a 30-day month, and today is close to its share",
      "monthlyBudget": 100000,
      "spentBeforeToday": 27000,
      "spentToday": 3000,
      "day": "2026-09-10",
      "snapshot": { "spentThisMonth": 30000, "floatingDailyLimit": 3476 },
      "status": "close"
    },
    {
      "why": "the same day, a little more spent, is over the day's share",
      "monthlyBudget": 100000,
      "spentBeforeToday": 27000,
      "spentToday": 4000,
      "day": "2026-09-10",
      "snapshot": { "spentThisMonth": 31000, "floatingDailyLimit": 3476 },
      "status": "over"
    },
    {
      "why": "and well under it is under",
      "monthlyBudget": 100000,
      "spentBeforeToday": 27000,
      "spentToday": 500,
      "day": "2026-09-10",
      "snapshot": { "spentThisMonth": 27500, "floatingDailyLimit": 3476 },
      "status": "under"
    },
    {
      "why": "the budget already spent leaves no share, and the month says over",
      "monthlyBudget": 50000,
      "spentBeforeToday": 60000,
      "spentToday": 0,
      "day": "2026-09-10",
      "snapshot": { "spentThisMonth": 60000, "floatingDailyLimit": 0 },
      "status": "over"
    },
    {
      "why": "spent to the penny on the last day is not over",
      "monthlyBudget": 3000,
      "spentBeforeToday": 3000,
      "spentToday": 0,
      "day": "2026-01-31",
      "snapshot": { "spentThisMonth": 3000, "floatingDailyLimit": 0 },
      "status": "under"
    },
    {
      "why": "the last day of February gets the whole remainder",
      "monthlyBudget": 60000,
      "spentBeforeToday": 20000,
      "spentToday": 0,
      "day": "2026-02-28",
      "snapshot": { "spentThisMonth": 20000, "floatingDailyLimit": 40000 },
      "status": "under"
    },
    {
      "why": "a leap February has one more day to spread across",
      "monthlyBudget": 58000,
      "spentBeforeToday": 0,
      "spentToday": 0,
      "day": "2028-02-01",
      "snapshot": { "spentThisMonth": 0, "floatingDailyLimit": 2000 },
      "status": "under"
    }
  ],
  "snapshotFromTotals": [
    {
      "why": "today is today's own spending; earlier days are behind it; later days are ignored",
      "monthlyBudget": 100000,
      "today": "2026-09-10",
      "totalsByDay": { "2026-09-01": 12000, "2026-09-09": 15000, "2026-09-10": 3000, "2026-09-12": 9000 },
      "snapshot": { "spentThisMonth": 30000, "spentToday": 3000, "floatingDailyLimit": 3476 },
      "status": "close"
    },
    {
      "why": "no budget, no picture",
      "monthlyBudget": null,
      "today": "2026-09-10",
      "totalsByDay": { "2026-09-10": 3000 },
      "snapshot": null,
      "status": null
    },
    {
      "why": "a budget of nothing is no budget",
      "monthlyBudget": 0,
      "today": "2026-09-10",
      "totalsByDay": { "2026-09-10": 3000 },
      "snapshot": null,
      "status": null
    }
  ],
  "budgetSwitches": [
    { "why": "dinars into euros at the typed rate", "rates": { "defaultCurrency": "DZD", "dzdPerEur": 250 }, "budget": 5000000, "from": "DZD", "to": "EUR", "result": 20000 },
    { "why": "and back", "rates": { "defaultCurrency": "EUR", "dzdPerEur": 250 }, "budget": 20000, "from": "EUR", "to": "DZD", "result": 5000000 },
    { "why": "euros into dollars by the fetched cross rate", "rates": { "defaultCurrency": "EUR", "usdPerEur": 1.1 }, "budget": 100000, "from": "EUR", "to": "USD", "result": 110000 },
    { "why": "without a rate the number stays", "rates": { "defaultCurrency": "DZD", "dzdPerEur": 250 }, "budget": 5000000, "from": "DZD", "to": "USD", "result": 5000000 },
    { "why": "never below one minor unit", "rates": { "defaultCurrency": "DZD", "dzdPerUsd": 100000 }, "budget": 1, "from": "DZD", "to": "USD", "result": 1 },
    { "why": "the same currency is the same budget", "rates": { "defaultCurrency": "DZD" }, "budget": 1234, "from": "DZD", "to": "DZD", "result": 1234 }
  ],
  "savingsHealth": [
    { "why": "no savings says nothing", "rates": { "defaultCurrency": "DZD" }, "savings": [], "budget": 5000000, "health": "unknown" },
    { "why": "no budget says nothing", "rates": { "defaultCurrency": "DZD" }, "savings": [["DZD", 100000]], "budget": null, "health": "unknown" },
    { "why": "a zero balance is no savings", "rates": { "defaultCurrency": "DZD" }, "savings": [["DZD", 0]], "budget": 5000000, "health": "unknown" },
    { "why": "below a tenth of the budget is low", "rates": { "defaultCurrency": "DZD" }, "savings": [["DZD", 499999]], "budget": 5000000, "health": "low" },
    { "why": "exactly a tenth is healthy", "rates": { "defaultCurrency": "DZD" }, "savings": [["DZD", 500000]], "budget": 5000000, "health": "healthy" },
    { "why": "euros count at the typed rate", "rates": { "defaultCurrency": "DZD", "dzdPerEur": 250 }, "savings": [["EUR", 2000]], "budget": 5000000, "health": "healthy" },
    { "why": "a missing rate counts at face value", "rates": { "defaultCurrency": "DZD" }, "savings": [["USD", 2000]], "budget": 5000000, "health": "low" }
  ],
  "averagePerDay": [
    { "why": "dinars average to whole dinars", "total": 50000, "days": 7, "currency": "DZD", "average": 7100 },
    { "why": "half a dinar rounds up", "total": 15000, "days": 2, "currency": "DZD", "average": 7500 },
    { "why": "DA70.49 rounds down", "total": 7049, "days": 1, "currency": "DZD", "average": 7000 },
    { "why": "euros keep their cents, truncated", "total": 50000, "days": 7, "currency": "EUR", "average": 7142 },
    { "why": "no day gone is nothing", "total": 50000, "days": 0, "currency": "DZD", "average": 0 }
  ]
}
