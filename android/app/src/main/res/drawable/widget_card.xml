<?xml version="1.0" encoding="utf-8"?>
<!-- The app's card, on a home screen: one step above the wallpaper with
     a hairline edge, and the same 20dp corner the app uses. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <stroke android:width="1dp" android:color="@color/widget_edge" />
    <corners android:radius="22dp" />
</shape>
