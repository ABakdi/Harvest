<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind the app while the process starts. It is the
     green the splash's own gradient begins on, so the launch reads as
     one continuous thing instead of a white flash and then a screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
